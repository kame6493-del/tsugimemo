<?xml version="1.0" encoding="utf-8"?>
<!-- ホーム画面のウィジェット(1.1.0 見本の「ウィジェット」): 紙の札に「ツギメモ」、線、灰の丸といまの1行、つぎの2行 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="ツギメモ"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="#1F1F2937"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_check"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:contentDescription="完了"
                android:padding="10dp"
                android:src="@drawable/widget_ring"
                android:tint="#B9BEC6" />

            <TextView
                android:id="@+id/w_top"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.62"
            android:maxLines="1"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_next1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:alpha="0.66"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/w_next2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginTop="2dp"
            android:alpha="0.66"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12.5sp" />
    </LinearLayout>
</FrameLayout>
